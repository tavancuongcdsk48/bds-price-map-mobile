{
  "expo": {
    "name": "Bản Đồ Giá BĐS",
    "slug": "bds-price-map-mobile",
    "scheme": "bds-price-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuongdms.bdspricemap",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần quyền vị trí để hiển thị giá bất động sản xung quanh bạn."
      }
    },
    "android": {
      "package": "com.cuongdms.bdspricemap",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_PLACEHOLDER"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép ứng dụng sử dụng vị trí của bạn để tìm bất động sản xung quanh."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
